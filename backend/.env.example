# Copy to backend/.env locally. Configure these values in Render's environment
# settings when deployed. Never commit real keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-secret-key
PORT=5000
FRONTEND_URL=http://localhost:5173
OPENAI_API_KEY=
# Optional. Defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini
# Use Ollama Cloud instead of OpenAI by setting these values. Keep all API
# keys in backend/.env only, never in frontend files.
AI_PROVIDER=ollama
OLLAMA_API_KEY=replace-with-your-ollama-api-key
OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_BASE_URL=https://ollama.com/v1
APP_URL=http://localhost:5173
# SMTP sender for invitation emails (for example, Resend SMTP or another provider).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Go.Together <hello@example.com>
SMTP_SECURE=false
