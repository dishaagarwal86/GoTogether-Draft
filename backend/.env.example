# Copy to backend/.env. Keep the copied file private.
# Use postgres for a direct connection, or supabase for the Supabase Data API.
DATABASE_PROVIDER=postgres
# Required for postgres (local, hosted, or a Supabase Postgres connection URL):
DATABASE_URL=postgres://gotogether:gotogether@localhost:5432/gotogether
# Required only for DATABASE_PROVIDER=supabase. Keep this key on the server.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
OPENAI_API_KEY=replace-with-your-openai-api-key
# Optional. Defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
